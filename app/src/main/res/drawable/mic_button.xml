<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#243B5A"/>
            <stroke
                android:width="3dp"
                android:color="#6EA8FF"/>
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <solid android:color="#152238"/>
            <stroke
                android:width="3dp"
                android:color="#416B9E"/>
        </shape>
    </item>

</selector>
